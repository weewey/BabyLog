default_platform(:ios)

platform :ios do
  desc "Run unit and UI tests"
  lane :test do
    run_tests(
      project: "LittleE.xcodeproj",
      scheme: "LittleE",
      device: "iPhone 16 Pro"
    )
  end

  desc "Validate ASC API credentials without touching signing or build"
  lane :validate_asc do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.yewwee.LittleE"
    )
    UI.success("ASC credentials OK. Latest TestFlight build number: #{latest}")
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    # Skip setup_ci on self-hosted runners — it creates an empty
    # fastlane_tmp_keychain that masks the user's login keychain
    # (where the signing identities actually live). Only run it on
    # GitHub-hosted ephemeral runners.
    setup_ci if ENV["CI"] && ENV["RUNNER_ENVIRONMENT"] == "github-hosted"

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    increment_build_number(
      build_number: latest_testflight_build_number(api_key: api_key) + 1,
      xcodeproj: "LittleE.xcodeproj"
    )

    match(type: "appstore", readonly: is_ci) if ENV["MATCH_GIT_URL"] && !ENV["MATCH_GIT_URL"].empty?

    build_app(
      project: "LittleE.xcodeproj",
      scheme: "LittleE",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
